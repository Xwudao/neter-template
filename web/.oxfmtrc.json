{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 90,
    "sortImports": true,
    "tabWidth": 2,
    "jsxSingleQuote": false,
    "ignorePatterns": [
        "src/auto-imports.d.ts",
        "dist/*",
        "src/routeTree.gen.ts"
    ]
}