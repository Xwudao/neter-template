{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript"
  ],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true
  },
  "rules": {
    "no-unused-vars": "warn"
  },
  "ignorePatterns": [
    "dist/*",
    "**/node_modules/**",
    "src/auto-imports.d.ts",
    "src/routeTree.gen.ts"
  ]
}